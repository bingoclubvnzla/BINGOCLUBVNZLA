# ==============================================================================
# BINGO CLUB VNZLA ONLINE — ENTORNO DE CONFIGURACIÓN (FASE 2.4)
# Auth Hardening: Google OAuth + Cloudflare Turnstile + Supabase Auth
# ==============================================================================
# NOTA DE SEGURIDAD CRÍTICA:
# Este archivo es un modelo público. NUNCA coloque claves privadas (service_role,
# secrets de base de datos, Google OAuth Client Secret ni Cloudflare Turnstile Secret Key)
# en este archivo, en el frontend ni en repositorios de Git.
# Las claves privadas residen exclusivamente en el panel de Supabase y Edge Functions.

# 1. URL de la instancia de Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Clave pública / anónima de Supabase (anon / publishable key)
# Seguro para uso en el cliente del navegador con Row Level Security (RLS) habilitado.
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Cloudflare Turnstile: Site Key Pública
# Obtenga su Site Key en https://dash.cloudflare.com/?to=/:account/turnstile
# La Secret Key correspondiente se configura en Supabase Dashboard > Authentication > Bot Protection
VITE_TURNSTILE_SITE_KEY=""

# 4. APP_URL: URL base pública de la aplicación para redirecciones y callbacks autorizados
APP_URL="https://bingoclubvnzla.vercel.app"

# 5. NOTA SOBRE GOOGLE OAUTH:
# El Client ID y Client Secret de Google Cloud Console se configuran exclusivamente en:
# Supabase Dashboard -> Authentication -> Providers -> Google
# Callback URL autorizada en Google Cloud Console:
# https://<tu-id-de-proyecto>.supabase.co/auth/v1/callback
